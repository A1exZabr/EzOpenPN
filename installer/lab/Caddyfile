{
	admin off
	persist_config off
	http_port 8080
	https_port 9443
	storage file_system /data/caddy
	default_sni {$PUBLIC_IP}
}

https://{$PUBLIC_IP}:9443 {
	tls /data/caddy/lab/server.crt /data/caddy/lab/server.key

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'none'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; script-src 'self'; style-src 'self'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	route {
		@internal path /internal/*
		respond @internal 404

		reverse_proxy control:8000 {
			header_up -Forwarded
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
			header_up Host {http.request.host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {remote_host}
		}
	}
}
