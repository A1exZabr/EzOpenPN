# syntax=docker/dockerfile:1.7

ARG GO_BUILDER_REPOSITORY=docker.io/library/golang
ARG GO_BUILDER_DIGEST=sha256:bcef992b77b1e2031aaaa51da75cebc32da8e9c182e12e633ea79023c79d9eff
ARG DISTROLESS_BASE_REPOSITORY=gcr.io/distroless/base-debian12
ARG DISTROLESS_BASE_DIGEST=sha256:5883c320d81f76c764e114c9ab14054f037bb040907816fc9028d80d9602a7c3

FROM ${GO_BUILDER_REPOSITORY}@${GO_BUILDER_DIGEST} AS builder
WORKDIR /src/runtime
COPY runtime/go.mod ./go.mod
RUN go mod download
COPY runtime/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -trimpath -buildvcs=false -ldflags="-s -w" \
    -o /out/cert-sync ./cmd/cert-sync

FROM ${DISTROLESS_BASE_REPOSITORY}@${DISTROLESS_BASE_DIGEST}
COPY --from=builder /out/cert-sync /usr/local/bin/cert-sync
USER 10004:11003
ENTRYPOINT ["/usr/local/bin/cert-sync"]
