{
	admin off
	persist_config off
	http_port 8080
	https_port 9443
	auto_https disable_redirects
	default_sni 127.0.0.1
	fallback_sni 127.0.0.1
	servers {
		protocols h1 h2
	}
}

(public_ip_certificate) {
	tls /test-certs/server.crt /test-certs/server.key {
		protocols tls1.2 tls1.3
	}
}

http:// {
	header -Server
	redir https://{host}{uri} 301
}

https://127.0.0.1:9443 {
	import public_ip_certificate

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'none'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; script-src 'self'; style-src 'self'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	route {
		@internal path /internal/*
		respond @internal 404

		reverse_proxy control:8000 {
			header_up -Forwarded
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
			header_up Host {http.request.host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {remote_host}
		}
	}
}

# Reality forwards every connection that is not a client of this server here,
# whatever name it asks for. The listener is reachable only from the internal
# network and uses the public IPv4 certificate managed above.
https://:8443 {
	import public_ip_certificate

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	@page path / /index.html
	handle @page {
		header Content-Type "text/html; charset=utf-8"
		respond <<STUB
			<!doctype html>
			<html lang="en">
			<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>Welcome</title>
			</head>
			<body>
			<main>
			<h1>Welcome</h1>
			<p>New content is coming soon.</p>
			</main>
			</body>
			</html>
			STUB 200
	}

	handle {
		respond 404
	}
}
